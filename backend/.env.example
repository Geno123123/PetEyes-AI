# backend/.env.example
# 실제 값은 절대 커밋하지 말고, 이 파일을 복사해서 .env로 만들어 채워 넣으세요.
#   cp .env.example .env

# --- Database ---
DB_USERNAME=root
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=

# --- Naver Login (OAuth2) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Naver Local Search API (병원 찾기) ---
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# --- Kakao Login (OAuth2) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- AWS S3 (이미지 업로드) ---
# local 프로파일 기준 변수명
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# prod 프로파일(배포)에서는 아래 이름을 사용합니다 (.github/workflows/deploy.yml 참고)
# AWS_S3_ACCESS_KEY=
# AWS_S3_SECRET_KEY=

# --- 배포(prod)에서만 필요 ---
AUTH_REDIRECT_URI=

# --- AI 서버 주소 ---
AI_SERVER_BASE_URL=https://your-ai-server-url
